# Railway deployment image for OpenClaw.
#
# Layers a first-boot bootstrap and a volume permission fix-up over the official
# runtime image so the Gateway and Control UI come up on a fresh Railway service
# without shell access. Builds in seconds because it does not compile the
# monorepo. Railway selects this file through the RAILWAY_DOCKERFILE_PATH
# service variable (set in .railway/railway.ts). See docs/install/railway.mdx.
#
# The default base is the `-browser` variant, which bakes in Chromium and Xvfb
# so the agent's browser tool works on a headless server. Use the plain tag
# (ghcr.io/openclaw/openclaw:<version>) for a smaller image without a browser.
#
# To deploy a locally built image instead of the published one:
#   docker build -t my-openclaw .
#   docker build --build-arg OPENCLAW_BASE_IMAGE=my-openclaw -f Dockerfile.railway .
ARG OPENCLAW_BASE_IMAGE="ghcr.io/openclaw/openclaw:2026.9.2-browser"
FROM ${OPENCLAW_BASE_IMAGE}

# The entrypoint starts as root only to chown the Railway volume, then drops to
# the image's unprivileged `node` user before running anything else.
USER root

# gog: the Google Workspace CLI behind the bundled `gog` skill (Sheets, Drive,
# Docs, Gmail, Calendar). Pinned release with per-architecture checksums;
# TARGETARCH is provided by BuildKit.
ARG TARGETARCH
ARG GOG_VERSION=0.39.1
ARG GOG_SHA256_AMD64=438efa460b8291f023299ad2ed5610701cad7508db88392039c0891e2175e3b1
ARG GOG_SHA256_ARM64=7c23b402c9234ba476e84b39ac6d875444b47ec516312a99e877e1386ba28295
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) sha="$GOG_SHA256_AMD64" ;; \
      arm64) sha="$GOG_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 -o /tmp/gog.tar.gz \
      "https://github.com/openclaw/gogcli/releases/download/v${GOG_VERSION}/gogcli_${GOG_VERSION}_linux_${TARGETARCH:-amd64}.tar.gz"; \
    echo "$sha  /tmp/gog.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/gog-extract; \
    tar -xzf /tmp/gog.tar.gz -C /tmp/gog-extract; \
    install -m 0755 /tmp/gog-extract/gog /usr/local/bin/gog; \
    rm -rf /tmp/gog.tar.gz /tmp/gog-extract; \
    /usr/local/bin/gog --version

# goplaces: Google Places API (New) CLI behind the bundled `goplaces` skill, used
# for structured local-business research. Needs GOOGLE_PLACES_API_KEY at runtime
# (set it under Plugins -> Skills -> goplaces in the Control UI).
ARG GOPLACES_VERSION=0.4.9
ARG GOPLACES_SHA256_AMD64=e7d5db4927c2da8cc443016120a02fdd8062391644715b2df32f7870722ea4ac
ARG GOPLACES_SHA256_ARM64=a83e1c0612f7f18bfc93cb2ac1174b553609c2f6159ae97037df3a12a362a4e1
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) sha="$GOPLACES_SHA256_AMD64" ;; \
      arm64) sha="$GOPLACES_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 -o /tmp/goplaces.tar.gz \
      "https://github.com/openclaw/goplaces/releases/download/v${GOPLACES_VERSION}/goplaces_${GOPLACES_VERSION}_linux_${TARGETARCH:-amd64}.tar.gz"; \
    echo "$sha  /tmp/goplaces.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/goplaces-extract; \
    tar -xzf /tmp/goplaces.tar.gz -C /tmp/goplaces-extract; \
    install -m 0755 "$(find /tmp/goplaces-extract -type f -name goplaces | head -n 1)" /usr/local/bin/goplaces; \
    rm -rf /tmp/goplaces.tar.gz /tmp/goplaces-extract; \
    /usr/local/bin/goplaces --version

COPY --chmod=0755 deploy/railway/entrypoint.sh /app/deploy/railway/entrypoint.sh
COPY --chmod=0644 deploy/railway/bootstrap.mjs /app/deploy/railway/bootstrap.mjs
# Workspace skills seeded into the agent workspace on first boot (see entrypoint).
COPY --chmod=0644 deploy/railway/skills /app/deploy/railway/skills

# HOME is pinned because the root->node privilege drop does not rewrite it.
# State, config, and workspace live on the Railway volume mounted at /data.
# gog keeps its OAuth client, tokens, and encrypted file keyring under
# GOG_HOME on the same volume; the entrypoint supplies GOG_KEYRING_PASSWORD.
ENV HOME=/home/node \
    OPENCLAW_HOME=/home/node \
    OPENCLAW_STATE_DIR=/data/.openclaw \
    OPENCLAW_CONFIG_PATH=/data/.openclaw/openclaw.json \
    OPENCLAW_WORKSPACE_DIR=/data/workspace \
    GOG_HOME=/data/gogcli \
    GOG_KEYRING_BACKEND=file \
    NODE_ENV=production

EXPOSE 8080

# HEALTHCHECK is inherited from the base image (dist/docker-healthcheck.js).
ENTRYPOINT ["tini", "-s", "--", "/app/deploy/railway/entrypoint.sh"]
CMD []
